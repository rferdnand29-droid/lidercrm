<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>
    </application>

    <!-- Permissions -->

    <!-- Rede — obrigatório para toda comunicação com Supabase/Backblaze/Worker -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Câmera — usada pelo <input type="file" accept="image/*"> (documentos.js,
         chat.js) quando o usuário escolhe "Tirar foto" no seletor nativo.
         Sem isso, o WebView nega o acesso silenciosamente em vez de abrir a câmera. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />

    <!-- Galeria — anexos gerais e fotos de perfil (documentos.js, chat.js).
         Android 13+ (API 33+) usa as permissões granulares abaixo; versões
         anteriores usam READ_EXTERNAL_STORAGE (maxSdkVersion evita o aviso
         do Play Console pedindo justificativa em API 33+). -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />

    <!-- Microfone — gravação de áudio no chat/documentos via getUserMedia
         (src/modules/documentos/runtime/audio-helper.js, MediaRecorder API). -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- CORREÇÃO 2026-08-07 (relatado: "gravar áudio pede permissão que já
         foi dada"): o próprio BridgeWebChromeClient do Capacitor
         (node_modules/@capacitor/android/.../BridgeWebChromeClient.java,
         método onPermissionRequest) pede RECORD_AUDIO **e**
         MODIFY_AUDIO_SETTINGS juntos, num único pedido, toda vez que o
         WebView chama getUserMedia({audio:true}) — e só libera o acesso
         se as DUAS vierem concedidas. MODIFY_AUDIO_SETTINGS nunca tinha
         sido declarada aqui; sem declaração no manifesto, o Android nega
         essa permissão especificamente sempre, mesmo com RECORD_AUDIO já
         concedida — derrubando o pedido inteiro (por isso parecia "pedir
         de novo uma permissão que já foi dada": a QUE JÁ FOI DADA
         realmente já estava OK, a outra nunca teve chance de ser). -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!-- Notificações push — obrigatório a partir do Android 13 (API 33) para
         o app poder mostrar notificações; sem isso o FCM (@capacitor/push-notifications)
         registra o token mas nada aparece na tela. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
</manifest>
